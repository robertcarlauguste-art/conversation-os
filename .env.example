APP_NAME=ConversationOS
APP_ENV=development

DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/conversation_os
REDIS_URL=redis://redis:6379/0
PROCESSING_MODE=inline
PROCESSING_MAX_TRIES=3
PROCESSING_JOB_TIMEOUT_SECONDS=300
OPERATIONS_QUEUE_ALERT_THRESHOLD=25
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001"]

OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Sprint 2 AI services
# ANTHROPIC_API_KEY is required for Claude memory extraction.
# OPENAI_API_KEY is optional. If blank, transcription is skipped.

ANTHROPIC_MODEL=claude-sonnet-5
OPENAI_WHISPER_MODEL=whisper-1
AI_REQUEST_TIMEOUT_SECONDS=60

SUPABASE_URL=
SUPABASE_KEY=

# Sprint 5 authentication. Leave AUTH_ENABLED=false for local demo mode.
AUTH_ENABLED=false
AUTH_DEV_USER_ID=dev_user
CLERK_SECRET_KEY=
CLERK_JWT_KEY=
CLERK_AUTHORIZED_PARTIES=["http://localhost:3000","http://localhost:3001"]

# Frontend Clerk keys (also expose these to the frontend container when enabled)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

STORAGE_BACKEND=local
STORAGE_ROOT=/app/storage/uploads
# Cloudflare R2 uses its S3 endpoint, region `auto`, and private bucket credentials.
S3_ENDPOINT_URL=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
